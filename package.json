{
  "name": "locktalk-local",
  "private": true,
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"npm run backend\" \"npm run frontend\" \"npm run open-browser\"",
    "backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8000",
    "frontend": "cd frontend && node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173 --strictPort",
    "open-browser": "wait-on --timeout 30000 http-get://127.0.0.1:8000/health http-get://127.0.0.1:5173/ && start \"\" \"http://127.0.0.1:5173/\""
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "wait-on": "^9.5.1"
  }
}
